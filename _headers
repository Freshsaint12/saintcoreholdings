# Cloudflare Pages — _headers
# Rules are matched top-down and merged; later rules win on conflict.
# Exact paths and trailing-splat wildcards only, so nothing depends on
# extension-glob support.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  # No includeSubDomains: this would bind every *.saintcoreholdings.com host
  # to HTTPS-only for a year, and the subdomain inventory is not verified.
  # Add it once you have confirmed every subdomain serves HTTPS.
  Strict-Transport-Security: max-age=31536000
  # script-src also allows the scripts Cloudflare itself injects on a proxied
  # zone: the Web Analytics RUM beacon (static.cloudflareinsights.com) and
  # Rocket Loader (ajax.cloudflare.com). Without these, enabling either
  # feature would be silently blocked by this policy. Email Obfuscation
  # injects from /cdn-cgi/ on the same origin, so 'self' already covers it.
  # Auto-injected Web Analytics posts to same-origin /cdn-cgi/rum ('self');
  # cloudflareinsights.com covers a manually embedded beacon.
  # Do not add `no-transform` to Cache-Control — it stops beacon injection.
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://static.cloudflareinsights.com https://ajax.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://www.googletagmanager.com https://www.google-analytics.com; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://*.analytics.google.com https://*.google-analytics.com https://www.googletagmanager.com https://stats.g.doubleclick.net https://cloudflareinsights.com; upgrade-insecure-requests

# Build-time fragments (see build.js). Served because Pages deploys the whole
# repo, but they are not pages — keep them out of search results.
/partials/*
  X-Robots-Tag: noindex

/images/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Cache-Control: public, max-age=31536000, immutable

/favicon-16x16.png
  Cache-Control: public, max-age=31536000, immutable

/favicon-32x32.png
  Cache-Control: public, max-age=31536000, immutable

/favicon-96x96.png
  Cache-Control: public, max-age=31536000, immutable

/apple-touch-icon.png
  Cache-Control: public, max-age=31536000, immutable

/web-app-manifest-192x192.png
  Cache-Control: public, max-age=31536000, immutable

/web-app-manifest-512x512.png
  Cache-Control: public, max-age=31536000, immutable

# Shared CSS/JS have no content hash in the filename, so keep these short
# enough that a deploy is picked up quickly.
/styles.css
  Cache-Control: public, max-age=3600, must-revalidate

/scripts.js
  Cache-Control: public, max-age=3600, must-revalidate

/site.webmanifest
  Cache-Control: public, max-age=3600, must-revalidate
